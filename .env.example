# Isaac Sim MCP Server Configuration

# MCP Server Settings
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8765
MCP_SERVER_NAME=IsaacSimMCP

# Isaac Sim Installation Path
ISAAC_SIM_PATH=/home/user/.local/share/ov/pkg/isaac_sim-2023.1.1
ISAAC_SIM_PYTHON_EXE=${ISAAC_SIM_PATH}/python.sh

# USD Settings
USD_CACHE_SIZE=1000
USD_ENABLE_CACHING=true
USD_DEFAULT_RESOLVER=ArDefaultResolver

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=detailed
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/simul_mcp.log
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_BACKUP_COUNT=5

# Performance Settings
MAX_CONCURRENT_OPERATIONS=10
OPERATION_TIMEOUT_SECONDS=30
MESH_DECIMATION_ENABLED=true
MESH_MAX_FACES=50000

# Viewport Capture Settings
VIEWPORT_DEFAULT_WIDTH=1920
VIEWPORT_DEFAULT_HEIGHT=1080
VIEWPORT_MAX_SIZE=2048
VIEWPORT_FORMAT=png
VIEWPORT_QUALITY=95

# Extension Settings
EXTENSION_ENABLED=true
EXTENSION_AUTO_START=false
EXTENSION_UI_ENABLED=true

# Development Settings
DEBUG_MODE=false
PROFILING_ENABLED=false
VERBOSE_USD_LOGGING=false

# Security Settings
ALLOWED_USD_EXTENSIONS=.usd,.usda,.usdc,.usdz
MAX_FILE_SIZE_MB=500
SANDBOX_MODE=true

# Isaac Sim Kit Settings
KIT_HEADLESS=false
KIT_ENABLE_LIVESTREAM=false
KIT_LIVESTREAM_PORT=8211
KIT_ENABLE_WEBRTC=false

# Omniverse Settings
OMNI_USER=""
OMNI_PASSWORD=""
OMNI_SERVER=""

# Advanced USD Settings
USD_STAGE_LOAD_RULES=LoadAll
USD_STAGE_POPULATION_MASK=""
USD_INTERPOLATION_TYPE=Linear
USD_ENABLE_INSTANCING=true

# Memory Management
MEMORY_LIMIT_GB=8
GC_THRESHOLD=1000
STAGE_CACHE_LIMIT=10

# Networking
NETWORK_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=1.0

# Feature Flags
ENABLE_MESH_ANALYSIS=true
ENABLE_MATERIAL_EXTRACTION=true
ENABLE_ANIMATION_SUPPORT=false
ENABLE_PHYSICS_QUERIES=true
ENABLE_LIGHTING_ANALYSIS=true
