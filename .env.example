# Simul MCP Server Configuration
# Uses Pydantic BaseSettings with nested delimiter "__"
# Example: SERVER__HOST=localhost
#
# Every variable here names a real Settings field and overrides the matching
# key of the YAML config file; the environment always wins over the file.

# Optional: YAML config file override. Defaults to the default.yaml shipped
# inside the simul_mcp package (src/simul_mcp/resources/config/default.yaml).
# CONFIG_FILE=/path/to/your/config.yaml

# Server Settings
SERVER__NAME=Simul – 3D Simulation & DCC Tools
SERVER__HOST=localhost
SERVER__PORT=8765
SERVER__MAX_CONNECTIONS=10
SERVER__TIMEOUT=30
SERVER__ENABLE_CORS=true
SERVER__CORS_ORIGINS=["http://localhost:*","https://localhost:*"]

# Isaac Sim Settings
# ISAAC_SIM_PATH (no section prefix) is the install root read by `simul-mcp isaac
# launch` / `install-bridge`; ISAAC_SIM__PATH is the same value as a Settings field.
# A path that does not exist is reported as a warning, not a startup failure.
ISAAC_SIM__PATH=/home/user/isaac-sim-6.0.1
ISAAC_SIM__HEADLESS=false
ISAAC_SIM__ENABLE_LIVESTREAM=false
ISAAC_SIM__LIVESTREAM_PORT=8211
ISAAC_SIM__ENABLE_WEBRTC=false
ISAAC_SIM__WIDTH=1920
ISAAC_SIM__HEIGHT=1080
ISAAC_SIM__SOCKET_HOST=127.0.0.1
ISAAC_SIM__SOCKET_PORT=8226
ISAAC_SIM__SOCKET_TIMEOUT=30.0
# Stock socket flavour: auto (probe once), python_server (Isaac Sim 6.0+), vscode (5.x)
ISAAC_SIM__SOCKET_PROTOCOL=auto
# Only when the 6.0 python_server was started with require_auth (simul-mcp isaac launch --auth-token)
# ISAAC_SIM__SOCKET_AUTH_TOKEN=
ISAAC_SIM__BRIDGE_ENABLED=true
ISAAC_SIM__BRIDGE_HOST=127.0.0.1
ISAAC_SIM__BRIDGE_PORT=8229
ISAAC_SIM__BRIDGE_TIMEOUT=30.0
ISAAC_SIM__BRIDGE_FALLBACK_TO_VSCODE=true
# Skip the bridge for BRIDGE_COOLDOWN_SECONDS after this many consecutive transport failures
ISAAC_SIM__BRIDGE_FAILURE_THRESHOLD=3
ISAAC_SIM__BRIDGE_COOLDOWN_SECONDS=30.0
ISAAC_SIM__DISCOVERY_DIR=/tmp/simul-mcp

# Blender Settings
BLENDER__ENABLED=true
# BLENDER__BINARY_PATH=/usr/bin/blender
BLENDER__MAX_SCENE_OBJECTS=200

# Unreal Engine Settings
UNREAL__ENABLED=true
UNREAL__HOST=localhost
UNREAL__PORT=30010
UNREAL__TIMEOUT=30
UNREAL__MAX_ACTORS=200
# UNREAL__PASSPHRASE: required when the editor is configured with
# `simul unreal setup --passphrase`. Accepts the matching plaintext or a
# pre-computed MD5 hex digest; UnrealRuntimeSession attaches
# `Passphrase: <md5>` to every Remote Control request automatically.
# Leave unset (default) when the editor has no passphrase enforcement.
# UNREAL__PASSPHRASE=
# UNREAL__TOOL_SURFACE: thin (default: health, ping, instances, capture,
# exec script) or full (every granular Unreal tool). The CLI flag
# `simul-mcp server --unreal-tools` overrides this.
# UNREAL__TOOL_SURFACE=thin

# USD Settings
USD__CACHE_ENABLED=true
USD__CACHE_SIZE=1000
USD__STAGE_CACHE_LIMIT=10
USD__LOAD_RULES=LoadAll
USD__POPULATION_MASK=
USD__INTERPOLATION_TYPE=Linear
USD__ENABLE_INSTANCING=true
USD__ENABLE_MULTITHREADING=true
USD__MAX_CONCURRENT_OPERATIONS=10
USD__OPERATION_TIMEOUT=30
USD__ALLOWED_EXTENSIONS=[".usd",".usda",".usdc",".usdz"]
USD__MAX_FILE_SIZE_MB=500

# Viewport Settings
VIEWPORT__DEFAULT_WIDTH=1920
VIEWPORT__DEFAULT_HEIGHT=1080
VIEWPORT__MAX_SIZE=2048
VIEWPORT__FORMAT=png
VIEWPORT__QUALITY=95
VIEWPORT__SAMPLES_PER_PIXEL=1
VIEWPORT__MAX_BOUNCES=4
VIEWPORT__ENABLE_DENOISING=true
VIEWPORT__FOV=45.0
VIEWPORT__NEAR_PLANE=0.1
VIEWPORT__FAR_PLANE=1000.0
# Unset picks <writable allowed root>/captures; must be inside the sandbox.
# VIEWPORT__CAPTURE_DIR=/tmp/simul_mcp/captures

# Logging Configuration
LOGGING__LEVEL=INFO
LOGGING__FORMAT=detailed
LOGGING__FILE_ENABLED=true
LOGGING__FILE_PATH=~/.simul/logs/simul_mcp.log
LOGGING__FILE_MAX_SIZE=10MB
LOGGING__FILE_BACKUP_COUNT=5
LOGGING__CONSOLE_ENABLED=true
LOGGING__CONSOLE_COLORED=true
LOGGING__PER_INSTANCE=false
LOGGING__RETENTION_DAYS=14
LOGGING__AUDIT_ENABLED=true
LOGGING__AUDIT_PATH=~/.simul/logs/audit.jsonl
LOGGING__STRUCTURED_ENABLED=false

# Security Settings
SECURITY__SANDBOX_ENABLED=true
SECURITY__ALLOWED_PATHS=["examples","tests/data","/tmp/simul_mcp"]
SECURITY__ALLOWED_URL_SCHEMES=["omniverse"]
SECURITY__ALLOWED_WRITE_URL_SCHEMES=[]
SECURITY__RATE_LIMITING_ENABLED=true
SECURITY__REQUESTS_PER_MINUTE=60
SECURITY__BURST_SIZE=10
